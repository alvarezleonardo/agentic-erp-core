{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-erp.dev/genui/components/TrendChart.v1.schema.json",
  "title": "TrendChart v1",
  "description": "Gráfico de líneas o barras hidratado desde SalidaSerie. Los valores son strings decimales del servidor.",
  "type": "object",
  "required": ["x", "series"],
  "additionalProperties": false,
  "properties": {
    "titulo": { "type": "string", "maxLength": 120 },
    "unidad": { "type": "string", "maxLength": 20, "x-source": "query" },
    "tipo": { "enum": ["linea", "barras"] },
    "x": { "type": "array", "minItems": 1, "maxItems": 400, "x-source": "query", "items": { "type": "string" } },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "x-source": "query",
      "items": {
        "type": "object",
        "required": ["id", "etiqueta", "valores"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "etiqueta": { "type": "string" },
          "valores": { "type": "array", "items": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" } }
        }
      }
    }
  }
}
