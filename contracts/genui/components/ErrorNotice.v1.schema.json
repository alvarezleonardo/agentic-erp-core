{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-erp.dev/genui/components/ErrorNotice.v1.schema.json",
  "title": "ErrorNotice v1",
  "description": "Informa que no se pudo resolver la intención. El código sale de un tool de la intención o es uno propio del orquestador.",
  "type": "object",
  "required": ["codigo", "mensaje"],
  "additionalProperties": false,
  "properties": {
    "codigo": { "type": "string", "pattern": "^[A-Za-z][A-Za-z_]{1,48}$" },
    "mensaje": { "type": "string", "minLength": 1, "maxLength": 200 },
    "accion_sugerida": { "type": "string", "maxLength": 200 },
    "reintentable": { "type": "boolean" }
  }
}
