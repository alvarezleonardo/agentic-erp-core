{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-erp.dev/genui/envelope.schema.json",
  "title": "Sobre GenUI v1",
  "description": "Todo mensaje del orquestador a la superficie. El modelo elige QUÉ mostrar; los datos y los montos vienen del servidor (x-source) y las acciones de un catálogo cerrado.",
  "type": "object",
  "required": ["v", "type", "message_id", "session_id", "intent_id"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": "1.0" },
    "type": { "enum": ["ui.render", "ui.update", "ui.dismiss", "ui.toast", "agent.status"] },
    "message_id": { "type": "string", "minLength": 8 },
    "session_id": { "type": "string" },
    "intent_id": { "type": "string" },
    "slot": { "enum": ["main", "toast"] },
    "component": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "component_version": { "type": "integer", "minimum": 1 },
    "data": { "type": "object" },
    "actions": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/action" } },
    "speech": { "type": "string", "maxLength": 280 },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dismiss_on": { "type": "array", "items": { "enum": ["action_done", "new_intent", "timeout"] } },
        "ttl_ms": { "type": "integer", "minimum": 1000 }
      }
    },
    "status": { "enum": ["pensando", "ejecutando", "listo", "error"] },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "trace_id": { "type": "string" }, "agent": { "type": "string" } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["ui.render", "ui.update", "ui.toast"] } }, "required": ["type"] },
      "then": { "required": ["component", "component_version", "data"] }
    }
  ],
  "$defs": {
    "money": {
      "type": "object",
      "required": ["monto", "moneda"],
      "additionalProperties": false,
      "properties": {
        "monto": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" },
        "moneda": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "label", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "kind": { "enum": ["primary", "secondary", "ghost", "danger"] },
        "confirms": { "type": "boolean", "description": "Solo el catálogo del servidor decide qué acciones confirman." },
        "step_up": { "enum": ["none", "motivo", "supervisor", "supervisor_y_motivo", "autorizacion"], "description": "Qué pide la superficie dentro del componente antes de confirmar: motivo (texto obligatorio), supervisor (usuario y PIN de otra persona con rol superior) o supervisor_y_motivo. autorizacion es el nombre anterior de supervisor y se sigue aceptando." }
      }
    }
  }
}
