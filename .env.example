# Copiá este archivo a .env y completá los valores. Nunca subas .env al repositorio.

# Adaptador LLM de ejemplo (cualquier endpoint compatible con /chat/completions)
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# Presupuesto de gasto (USD). Con el tope alcanzado el proveedor deja de llamar al modelo.
LLM_LIMITE_USD=5
# Tabla de precios opcional: {"mi-modelo":{"entrada":0.5,"salida":2}} (USD por millón de tokens)
# LLM_PRECIOS_JSON=

# Carpeta de trazas JSONL (opcional)
# TRAZAS_DIR=./trazas
